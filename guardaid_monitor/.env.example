# Current architecture: SQLite metadata + local filesystem media.
GUARDAID_PERSISTENCE_MODE=sqlite
GUARDAID_MAX_UPLOAD_MB=500
GUARDAID_DATA_DIR=.\runtime_data
# GUARDAID_DATABASE_PATH=.\runtime_data\database\guardaid.db

# Firebase is optional and independent of SQLite/local media.
GUARDAID_AUTH_MODE=disabled
GUARDAID_NOTIFICATION_MODE=console
# Enable only after following FIREBASE_AUTH_FCM_SETUP_TUTORIAL.md.
# GUARDAID_AUTH_MODE=firebase
# GUARDAID_NOTIFICATION_MODE=firebase
# GUARDAID_FIREBASE_PROJECT_ID=your-project-id
# GUARDAID_FIREBASE_CREDENTIALS=C:\secure\outside-the-repository\service-account.json

# Optional model locations. Never place private credentials here.
GUARDAID_VIOLENCE_CHECKPOINT=..\model_runs\mc3_4s16f2\run_four_ui_20261007_234526_491833\best_model.pt
GUARDAID_WEAPON_CHECKPOINT=..\model_runs\yolov9_selected_sources_50epoch\runs\sel50_20261011_193754_83560d\best_inference.pt
GUARDAID_YOLOV9_ROOT=..\results (4)\yolov9
GUARDAID_WEAPON_THRESHOLDS=..\model_runs\yolov9_selected_sources_50epoch\runs\sel50_20261011_193754_83560d\sensitivity_thresholds.json
GUARDAID_HF_CACHE=C:\tmp\guardaid-hf
GUARDAID_MAX_ACTIVE_FEEDS=4
# Safety gate before Qwen loading; this does not cap or reduce actual RAM use.
GUARDAID_VLM_MIN_AVAILABLE_RAM_GB=3.0
