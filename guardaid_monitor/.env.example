# Configuration names only. Supply real values locally; never commit private files.
# The application reads process environment variables, not this template automatically.
GUARDAID_PERSISTENCE_MODE=sqlite
GUARDAID_AUTH_MODE=disabled
GUARDAID_NOTIFICATION_MODE=console
GUARDAID_DATA_DIR=./runtime_data
GUARDAID_MAX_UPLOAD_MB=500
GUARDAID_MAX_ACTIVE_FEEDS=4
GUARDAID_OLLAMA_URL=http://127.0.0.1:11434
# GUARDAID_FIREBASE_PROJECT_ID=your-project-id
# GUARDAID_FIREBASE_CREDENTIALS=/path/outside/repository/service-account.json
# Optional overrides for the external model files and bundled runtime:
# GUARDAID_VIOLENCE_CHECKPOINT=/path/outside/repository/mc3-checkpoint.pt
# GUARDAID_WEAPON_CHECKPOINT=/path/outside/repository/weapon-checkpoint.pt
# GUARDAID_YOLOV9_ROOT=/path/to/runtime_dependencies/yolov9
# GUARDAID_WEAPON_THRESHOLDS=/path/to/deployment/weapon_thresholds.json
