      ],
      "indexes": [
        "CREATE INDEX ix_cameras_location ON cameras(location_id);"
      ],
      "notes": ""
    },
    {
      "name": "media_files",
      "purpose": "实际文件的唯一元数据；视频源、截图、证据片段共享文件模型",
      "columns": [
        [
          "id",
          "TEXT",
          "PRIMARY KEY NOT NULL CHECK(length(trim(id)) > 0 AND instr(id,char(0))=0)",
          "沿用既有公开 ID，避免改动手机深链接、证据 URL 和幂等引用"
        ],
        [
          "relative_path",
          "TEXT",
          "NOT NULL CHECK(length(trim(relative_path)) > 0)",
          "服务器媒体根目录下的 POSIX 相对路径；SQL 防越界形态，服务仍须 realpath containment 检查"
        ],
        [
          "original_filename",
          "TEXT",
          "",
          "上传文件名只作元数据；不作为服务器文件路径"
        ],
        [
          "media_kind",
          "TEXT",
          "NOT NULL CHECK(media_kind IN ('camera_source','evidence_clip','evidence_image'))",
          "与当前文件分类保持一致"
        ],
        [
          "content_type",
          "TEXT",
          "NOT NULL CHECK(length(trim(content_type)) > 0)",
          "MIME 类型由媒体处理器验证，不臆造固定长度"
        ],
        [
          "size_bytes",
          "INTEGER",
          "NOT NULL CHECK(size_bytes >= 0)",
          "字节大小非负；不存 BLOB 视频内容"
        ],
        [
          "sha256",
          "BLOB",
          "CHECK(sha256 IS NULL OR length(sha256)=32)",
          "SHA-256 原始摘要固定 32 字节；API 显示时转回 64 位十六进制"
        ],
        [
          "created_at",
          "INTEGER",
          "NOT NULL CHECK(created_at >= 0)",
          "UTC Unix 微秒；保留既有微秒精度，排序和期限比较直接使用整数"
        ]
      ],
      "rules": [
        "UNIQUE(relative_path)",
        "CHECK(substr(relative_path,1,1)<>'/' AND instr(relative_path,':')=0 AND instr(relative_path,char(92))=0 AND instr(relative_path,char(0))=0 AND instr('/'||relative_path||'/','/../')=0 AND instr('/'||relative_path||'/','/./')=0 AND instr(relative_path,'//')=0)"
      ],
      "indexes": [],
      "notes": ""
    }
  ],
